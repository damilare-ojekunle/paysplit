# Copy to .env and fill in. Never commit real values.

# Neon Postgres. Use the DIRECT (non-pooled) connection string for both:
# the pooled URL breaks Prisma interactive transactions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Public base URL of the app (used in email links and pay-in redirects)
APP_URL="http://localhost:3000"

# Long random strings: `openssl rand -base64 32`
SESSION_SECRET=""     # HMAC key for hashing identity numbers
CRON_SECRET=""        # Vercel Cron sends this as a Bearer token

# Flutterwave (test mode) — dashboard > Settings > API keys / Webhooks
FLW_SECRET_KEY=""
FLW_WEBHOOK_HASH=""   # must match "Secret hash" in the Flutterwave webhook settings
# FLW_SANDBOX_BVN="12345678901"  # optional, BVN used for sandbox virtual accounts

# Dojah (sandbox) — dashboard > Developers > Configuration
DOJAH_APP_ID=""
DOJAH_SECRET_KEY=""
# DOJAH_BASE_URL="https://sandbox.dojah.io"

# Brevo transactional email. Without these, emails are printed to the console in dev.
BREVO_API_KEY=""
EMAIL_FROM=""         # must be a verified sender in Brevo

# Admin account created by `pnpm tsx scripts/seed-admin.mts`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
